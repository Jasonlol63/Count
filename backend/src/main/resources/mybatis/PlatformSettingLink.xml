<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.eazycount.dao.PlatformSettingDao">

    <resultMap id="PlatformSetting" type="com.eazycount.entity.PlatformSetting">
        <id property="id" column="id"/>
        <result property="telegramSupportLink" column="telegram_support_link"/>
        <result property="updatedByType" column="updated_by_type"/>
        <result property="updatedBy" column="updated_by"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <select id="findLink" resultMap="PlatformSetting">
        SELECT * FROM platform_settings
        WHERE id = 1
    </select>

    <update id="updateLink">
        UPDATE platform_settings
        SET telegram_support_link = #{telegramSupportLink},
            updated_by = #{updatedBy},
            updated_by_type = #{updatedByType},
            updated_at = NOW()
        WHERE id = 1
    </update>

</mapper>
